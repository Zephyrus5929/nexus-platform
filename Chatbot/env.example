# ─── Environment variables ────────────────────────────────────────────────
# Copy to .env and fill in your values. Never commit this file.

# ── Google Gemini ─────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# S&P 500 YTD return used in the chat system prompt as the benchmark
# (until a real market-data feed is wired in). Defaults to 9.8.
# BENCHMARK_YTD=9.8

# ── Auth / JWT ────────────────────────────────────────────────────────────
# Must match Auth-Server SECRET_KEY in the integrated stack. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-64-byte-random-string
# Alias accepted by server.js if JWT_SECRET is unset:
# SECRET_KEY=same-as-auth-server

# The client ID your widget sends when requesting a token
WIDGET_CLIENT_ID=finance-widget

# The origin(s) allowed to call this API (CORS)
WIDGET_ORIGIN=http://localhost:8080

# If using an external auth provider (Auth0, AWS Cognito, etc.),
# provide the JWKS URL instead of JWT_SECRET to verify tokens:
# AUTH_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json

# ── Database ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financedb
DB_USER=financedb
DB_PASSWORD=financedb
DB_SSL=false          # Set to true for hosted databases (RDS, Supabase, Neon…)

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development  # production | development
