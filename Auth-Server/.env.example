# Auth Server — copy to .env and fill in values

# Required: JWT signing key (must match Chatbot JWT_SECRET in integrated stack)
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:8080,http://localhost:3001

DATABASE_URL=sqlite:///./data/auth.db
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=20
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
