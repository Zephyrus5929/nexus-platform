# Root environment for docker compose — copy to .env

# Required: shared JWT secret (Auth SECRET_KEY + Chatbot JWT_SECRET)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-hex-string

# Required for AI chat responses (optional for portfolio-only testing)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# PostgreSQL password (used by postgres + chatbot services)
POSTGRES_PASSWORD=financedb
